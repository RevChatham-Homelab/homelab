[Unit]
Description=Create a consistent local backup of the PLA traffic database
After=pla-cloudflare-analytics.service

[Service]
Type=oneshot
User=pla-analytics
Group=pla-analytics
ExecStart=/usr/bin/python3 /usr/local/lib/pla-cloudflare-analytics/collector.py --config /etc/pla/cloudflare-analytics.conf backup
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/pla
ReadWritePaths=/var/lib/pla/analytics /var/backups/pla-analytics
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
